# Copier ce fichier en .env (non versionné) puis remplacer les valeurs.
# Générer des valeurs aléatoires, par exemple :  openssl rand -base64 32

# Mot de passe de la base PostgreSQL (docker-compose)
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-aleatoire

# Clé de signature des JWT : 32 caractères minimum
JWT_SECRET=remplacer-par-une-cle-aleatoire-d-au-moins-32-caracteres

# Optionnel : adresse IP du proxy inverse (Caddy) vue depuis le conteneur de l'API, par exemple
# la passerelle Docker (docker network inspect <réseau> → Gateway). L'API ne croit X-Forwarded-For
# que de cette adresse et du loopback ; le limiteur de connexion compte alors par adresse cliente.
FORWARDED_KNOWN_PROXY=
