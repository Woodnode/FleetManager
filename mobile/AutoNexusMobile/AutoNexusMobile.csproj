<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AutoNexusMobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XAML compilé en C# à la génération (plus rapide au démarrage que l'inflation). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>AutoNexus</ApplicationTitle>
		<ApplicationId>com.autonexus.mobile</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône et écran de démarrage : le logo du web (LogoIcon.tsx) sur le fond de sa barre latérale. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0C1020" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0C1020" BaseSize="80,90" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\logo.svg" BaseSize="32,36" />

		<!-- Inter (OFL), la police du web, et Lucide (ISC), sa famille d'icônes. Licences à côté. -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="ZXing.Net.Maui" Version="0.10.3" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AutoNexusMobile.Core\AutoNexusMobile.Core.csproj" />
	</ItemGroup>

	<!-- Android : la configuration réseau qui autorise l'HTTP local n'est embarquée qu'en Debug,
	     branchée par l'attribut [Application] de MainApplication. -->
	<ItemGroup Condition="'$(Configuration)' != 'Debug'">
		<AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
	</ItemGroup>

	<!-- Hôte de l'API de production, fixé à la compilation : dotnet publish -p:AutoNexusApiHost=https://... -->
	<ItemGroup Condition="'$(AutoNexusApiHost)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>AutoNexusApiHost</_Parameter1>
			<_Parameter2>$(AutoNexusApiHost)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
