<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AutoNexusMobile.Converters"
             xmlns:views="clr-namespace:AutoNexusMobile.Views"
             x:Class="AutoNexusMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <views:InterventionCardTemplate />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertedBoolConverter x:Key="InvertedBool" />
            <converters:HasValueConverter x:Key="HasValue" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
