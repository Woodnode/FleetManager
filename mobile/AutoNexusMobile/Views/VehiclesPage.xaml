<?xml version="1.0" encoding="utf-8" ?>
<!-- Liste des véhicules (Vehicles.tsx à 375 px, vue grille) : titre et nombre, bouton Ajouter
     pour l'administrateur et le gérant, pilules de statut défilantes, recherche, cartes
     véhicule. Toucher une carte ouvre la fiche (statut, modification, interventions). -->
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:AutoNexusMobile.Views"
                xmlns:controls="clr-namespace:AutoNexusMobile.Controls"
                xmlns:viewmodels="clr-namespace:AutoNexusMobile.ViewModels"
                xmlns:icons="clr-namespace:AutoNexusMobile.Resources"
                x:Class="AutoNexusMobile.Views.VehiclesPage"
                x:DataType="viewmodels:VehiclesViewModel"
                Shell.NavBarIsVisible="False"
                BackgroundColor="{StaticResource Sidebar}">

    <!-- Fond de page sous l'en-tête : la page elle-même garde le sombre de l'en-tête, qui
         remplit la zone de la barre d'état. -->
    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
        <controls:AppHeader />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Vehicles}" RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,20,16,14" Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Véhicules" Style="{StaticResource TextDisplay}" SemanticProperties.HeadingLevel="Level1" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource TextMeta}" FontSize="14" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Ajouter" Command="{Binding CreateCommand}" IsVisible="{Binding CanCreate}" VerticalOptions="Center"
                                    ImageSource="{FontImageSource Glyph={x:Static icons:Icons.Plus}, FontFamily=Lucide, Size=16, Color=White}" ContentLayout="Left,6" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                            <HorizontalStackLayout Padding="16,0" BindableLayout.ItemsSource="{Binding StatusChoices}"
                                                   BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
                        </ScrollView>

                        <Border Style="{StaticResource Field}" Margin="0,-8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="{x:Static icons:Icons.Search}" Style="{StaticResource IconMuted}" FontSize="16" />
                                <Entry Grid.Column="1" Text="{Binding Search}" Placeholder="VIN, marque, modèle..." ReturnType="Search"
                                       IsSpellCheckEnabled="False" SemanticProperties.Description="Rechercher un véhicule" />
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" BorderWidth="0" Background="Transparent" HeightRequest="40" WidthRequest="40"
                                        Text="{x:Static icons:Icons.ScanBarcode}" Command="{Binding ScanCommand}"
                                        TextColor="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}"
                                        SemanticProperties.Description="Scanner un NIV" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerText}" />
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="10">
                            <BoxView HeightRequest="104" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                            <BoxView HeightRequest="104" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                            <BoxView HeightRequest="104" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="8" Padding="0,30">
                            <Label Text="{x:Static icons:Icons.Car}" Style="{StaticResource IconMuted}" FontSize="30" />
                            <Label Text="{Binding EmptyText}" Style="{StaticResource TextMeta}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:VehicleItem">
                        <Border Style="{StaticResource Card}" Margin="16,0,16,10" Padding="16,14" SemanticProperties.Description="{Binding Name}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.OpenCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                <Border Grid.RowSpan="2" Style="{StaticResource IconTile}" WidthRequest="38" HeightRequest="38" VerticalOptions="Start">
                                    <Label Text="{x:Static icons:Icons.Car}" Style="{StaticResource IconAccent}" FontSize="17" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TextStrong}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{x:Static icons:Icons.ChevronRight}" Style="{StaticResource IconMuted}" FontSize="16" />
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Dto.Vin}" Style="{StaticResource TextMono}" FontSize="12" />
                                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                    <controls:StatusBadge Value="{Binding Dto.Status}" Text="{Binding Dto.StatusLabel}" />
                                    <Label Grid.Column="1" Text="{Binding Details}" Style="{StaticResource TextMeta}" FontSize="12"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid Padding="0,6,0,24">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HeightRequest="24" />
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>

</views:PageBase>
