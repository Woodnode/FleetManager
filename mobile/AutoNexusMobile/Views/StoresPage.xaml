<?xml version="1.0" encoding="utf-8" ?>
<!-- Enseignes (Stores.tsx à 375 px) : une carte par enseigne avec adresse, nombre de véhicules,
     disponibles et en cours, barre de disponibilité colorée ; modifier et supprimer pour
     l'administrateur. -->
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:AutoNexusMobile.Views"
                xmlns:controls="clr-namespace:AutoNexusMobile.Controls"
                xmlns:viewmodels="clr-namespace:AutoNexusMobile.ViewModels"
                xmlns:icons="clr-namespace:AutoNexusMobile.Resources"
                x:Class="AutoNexusMobile.Views.StoresPage"
                x:DataType="viewmodels:StoresViewModel"
                Shell.NavBarIsVisible="False"
                BackgroundColor="{StaticResource Sidebar}">

    <!-- Fond de page sous l'en-tête : la page elle-même garde le sombre de l'en-tête, qui
         remplit la zone de la barre d'état. -->
    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
        <controls:AppHeader />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,20,16,28" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Enseignes" Style="{StaticResource TextDisplay}" SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource TextMeta}" FontSize="14" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Ajouter" Command="{Binding CreateCommand}" IsVisible="{Binding IsAdmin}" VerticalOptions="Center"
                                ImageSource="{FontImageSource Glyph={x:Static icons:Icons.Plus}, FontFamily=Lucide, Size=16, Color=White}" ContentLayout="Left,6" />
                    </Grid>

                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerText}" />
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="12">
                        <BoxView HeightRequest="150" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                        <BoxView HeightRequest="150" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="8" Padding="0,30">
                        <Label Text="{x:Static icons:Icons.Building}" Style="{StaticResource IconMuted}" FontSize="30" />
                        <Label Text="Aucune enseigne enregistrée" Style="{StaticResource TextMeta}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Stores}" IsVisible="{Binding IsReady}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StoreItem">
                                <Border Style="{StaticResource Card}" SemanticProperties.Description="{Binding Dto.Name}">
                                    <VerticalStackLayout Spacing="14">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Style="{StaticResource IconTile}" WidthRequest="38" HeightRequest="38" VerticalOptions="Start">
                                                <Label Text="{x:Static icons:Icons.Building}" Style="{StaticResource IconAccent}" FontSize="16" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding Dto.Name}" Style="{StaticResource TextStrong}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Address}" Style="{StaticResource TextMeta}" FontSize="12" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding City}" Style="{StaticResource TextMeta}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Start"
                                                                   IsVisible="{Binding BindingContext.IsAdmin, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}">
                                                <Button Style="{StaticResource IconButton}" BorderWidth="0" Background="Transparent" Text="{x:Static icons:Icons.Pencil}" FontSize="16"
                                                        TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                                        Command="{Binding BindingContext.EditCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                                                        CommandParameter="{Binding .}" SemanticProperties.Description="Modifier l'enseigne" />
                                                <Button Style="{StaticResource IconButton}" BorderWidth="0" Background="Transparent" Text="{x:Static icons:Icons.Trash}" FontSize="16"
                                                        TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                                        Command="{Binding BindingContext.DeleteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                                                        CommandParameter="{Binding .}" SemanticProperties.Description="Supprimer l'enseigne" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView Style="{StaticResource Divider}" Margin="0,-2,0,0" />
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                <Label Text="{Binding VehicleCount}" Style="{StaticResource TextMeta}" FontSize="12" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#34D399" VerticalOptions="Center" />
                                                    <Label Text="{Binding AvailableText}" FontFamily="InterMedium" FontSize="12" Style="{StaticResource TextBody}" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2" Spacing="5" IsVisible="{Binding HasInIntervention}">
                                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#60A5FA" VerticalOptions="Center" />
                                                    <Label Text="{Binding InInterventionText}" FontFamily="InterMedium" FontSize="12" Style="{StaticResource TextBody}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <ProgressBar Progress="{Binding AvailabilityRatio}" ProgressColor="{Binding BarColor}" HeightRequest="6" />
                                            <Label Text="{Binding AvailabilityText}" Style="{StaticResource TextMeta}" FontSize="11" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</views:PageBase>
