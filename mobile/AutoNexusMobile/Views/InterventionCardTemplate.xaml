<?xml version="1.0" encoding="utf-8" ?>
<!-- Carte d'intervention, reprise de la vue mobile de la liste du web (Interventions.tsx) :
     véhicule et date, NIV, badges type et statut, technicien et enseigne, commentaire, et
     l'action suivante (Commencer en bleu, Terminer en vert), comme les boutons du web. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:AutoNexusMobile.Controls"
                    xmlns:icons="clr-namespace:AutoNexusMobile.Resources"
                    xmlns:viewmodels="clr-namespace:AutoNexusMobile.ViewModels"
                    x:Class="AutoNexusMobile.Views.InterventionCardTemplate">

    <DataTemplate x:Key="InterventionCard" x:DataType="viewmodels:InterventionItem">
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10"
                SemanticProperties.Description="{Binding Vehicle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BindingContext.OpenCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                                      CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Vehicle}" Style="{StaticResource TextStrong}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Vin}" Style="{StaticResource TextMono}" FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                        <Label Text="{Binding Date}" Style="{StaticResource TextMeta}" HorizontalTextAlignment="End" />
                        <Label Text="En retard" FontFamily="InterSemiBold" FontSize="12" HorizontalTextAlignment="End" IsVisible="{Binding IsOverdue}"
                               TextColor="{AppThemeBinding Light={StaticResource RedInkLight}, Dark={StaticResource RedInkDark}}" />
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="6">
                    <controls:StatusBadge Value="{Binding Dto.Type}" Text="{Binding Dto.TypeLabel}" />
                    <controls:StatusBadge Value="{Binding Dto.Status}" Text="{Binding Dto.StatusLabel}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{x:Static icons:Icons.Clock}" Style="{StaticResource IconMuted}" FontSize="14" />
                    <Label Text="{Binding Window}" Style="{StaticResource TextMeta}" />
                </HorizontalStackLayout>
                <Label Text="{Binding People}" Style="{StaticResource TextMeta}" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Comment}" Style="{StaticResource TextBody}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation"
                       IsVisible="{Binding Comment, Converter={StaticResource HasValue}}" />
                <Button Text="{Binding NextActionLabel}" IsVisible="{Binding HasNextAction}" Margin="0,4,0,0"
                        Command="{Binding BindingContext.QuickActionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                        CommandParameter="{Binding .}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding NextActionIsStart}" Value="True">
                            <Setter Property="Style" Value="{StaticResource TintButton}" />
                            <Setter Property="ImageSource" Value="{FontImageSource Glyph={x:Static icons:Icons.Play}, FontFamily=Lucide, Size=16, Color={StaticResource Brand500}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding NextActionIsComplete}" Value="True">
                            <Setter Property="Style" Value="{StaticResource SuccessButton}" />
                            <Setter Property="ImageSource" Value="{FontImageSource Glyph={x:Static icons:Icons.CheckCheck}, FontFamily=Lucide, Size=16, Color={StaticResource EmeraldDot}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Border>
    </DataTemplate>

</ResourceDictionary>
