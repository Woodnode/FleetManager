<?xml version="1.0" encoding="utf-8" ?>
<!-- « Ma journée » du technicien (propre au mobile) : en-tête de l'app, date du jour et bilan,
     scan du NIV à portée de pouce, puis les sections de la journée en cartes d'intervention. -->
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:AutoNexusMobile.Views"
                xmlns:controls="clr-namespace:AutoNexusMobile.Controls"
                xmlns:viewmodels="clr-namespace:AutoNexusMobile.ViewModels"
                xmlns:icons="clr-namespace:AutoNexusMobile.Resources"
                x:Class="AutoNexusMobile.Views.TodayPage"
                x:DataType="viewmodels:TodayViewModel"
                Shell.NavBarIsVisible="False"
                BackgroundColor="{StaticResource Sidebar}">

    <!-- Fond de page sous l'en-tête : la page elle-même garde le sombre de l'en-tête, qui
         remplit la zone de la barre d'état. -->
    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
        <controls:AppHeader />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,20,16,28" Spacing="0">

                    <Label Text="{Binding Greeting}" Style="{StaticResource TextMeta}" FontSize="14" />
                    <Label Text="{Binding DayTitle}" Style="{StaticResource TextDisplay}" Margin="0,2,0,2" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Summary}" Style="{StaticResource TextMeta}" FontSize="14" Margin="0,0,0,16" />

                    <!-- Scan : le geste qui ouvre la fiche du véhicule devant soi. -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,22" SemanticProperties.Description="Scanner le NIV d'un véhicule">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScanCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}" WidthRequest="44" HeightRequest="44">
                                <Label Text="{x:Static icons:Icons.ScanBarcode}" Style="{StaticResource IconAccent}" FontSize="22" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="Scanner un NIV" Style="{StaticResource TextStrong}" />
                                <Label Text="Ouvre la fiche du véhicule et ses interventions" Style="{StaticResource TextMeta}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{x:Static icons:Icons.ChevronRight}" Style="{StaticResource IconMuted}" />
                        </Grid>
                    </Border>

                    <!-- Squelette pendant le premier chargement -->
                    <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="10">
                        <BoxView HeightRequest="14" WidthRequest="120" HorizontalOptions="Start" CornerRadius="4"
                                 Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                        <BoxView HeightRequest="150" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                        <BoxView HeightRequest="150" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}" Margin="0,0,0,12">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerText}" />
                    </Border>

                    <!-- Journée vide -->
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="8" Padding="0,24" HorizontalOptions="Center">
                        <Label Text="{x:Static icons:Icons.CircleCheck}" Style="{StaticResource IconMuted}" FontSize="32" />
                        <Label Text="Rien de prévu aujourd'hui" Style="{StaticResource TextStrong}" HorizontalTextAlignment="Center" />
                        <Label Text="Les interventions qui vous sont confiées s'afficheront ici." Style="{StaticResource TextMeta}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" IsVisible="{Binding IsReady}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:AgendaGroup">
                                <VerticalStackLayout Margin="0,0,0,10">
                                    <HorizontalStackLayout Spacing="8" Margin="2,0,0,10">
                                        <Label Text="{Binding Title}" Style="{StaticResource TextOverline}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource RedInkLight}, Dark={StaticResource RedInkDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding CountText}" Style="{StaticResource TextOverline}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}"
                                                         BindableLayout.ItemTemplate="{StaticResource InterventionCard}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</views:PageBase>
