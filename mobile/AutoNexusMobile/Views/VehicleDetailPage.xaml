<?xml version="1.0" encoding="utf-8" ?>
<!-- Fiche d'un véhicule : carte d'identité (marque, modèle, NIV, statut, année, kilométrage,
     enseigne), actions selon le rôle, puis l'historique des interventions en cartes. -->
<views:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:AutoNexusMobile.Views"
                xmlns:controls="clr-namespace:AutoNexusMobile.Controls"
                xmlns:viewmodels="clr-namespace:AutoNexusMobile.ViewModels"
                xmlns:icons="clr-namespace:AutoNexusMobile.Resources"
                x:Class="AutoNexusMobile.Views.VehicleDetailPage"
                x:DataType="viewmodels:VehicleDetailViewModel"
                Title="Véhicule">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14">

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerText}" />
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="12">
                    <BoxView HeightRequest="190" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                    <BoxView HeightRequest="120" CornerRadius="14" Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding HasVehicle}">
                    <!-- Identité -->
                    <Border Style="{StaticResource Card}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Style="{StaticResource IconTile}" WidthRequest="48" HeightRequest="48">
                                    <Label Text="{x:Static icons:Icons.Car}" Style="{StaticResource IconAccent}" FontSize="22" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource TextDisplay}" FontSize="20" SemanticProperties.HeadingLevel="Level1" />
                                    <Label Text="{Binding Vehicle.Vin}" Style="{StaticResource TextMono}" />
                                </VerticalStackLayout>
                            </Grid>
                            <controls:StatusBadge Value="{Binding Vehicle.Status}" Text="{Binding Vehicle.StatusLabel}" />
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Année" Style="{StaticResource TextOverline}" />
                                    <Label Text="{Binding Year}" Style="{StaticResource TextStrong}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Kilométrage" Style="{StaticResource TextOverline}" />
                                    <Label Text="{Binding Mileage}" Style="{StaticResource TextStrong}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="3">
                                    <Label Text="Enseigne" Style="{StaticResource TextOverline}" />
                                    <Label Text="{Binding Vehicle.StoreName}" Style="{StaticResource TextStrong}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Actions -->
                    <Button Text="Planifier une intervention" Command="{Binding PlanCommand}" IsVisible="{Binding CanPlan}"
                            ImageSource="{FontImageSource Glyph={x:Static icons:Icons.CalendarClock}, FontFamily=Lucide, Size=17, Color=White}" ContentLayout="Left,8" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Changer le statut" Style="{StaticResource TintButton}" Command="{Binding ChangeStatusCommand}" IsEnabled="{Binding IsIdle}" IsVisible="{Binding CanManage}"
                                ImageSource="{FontImageSource Glyph={x:Static icons:Icons.Refresh}, FontFamily=Lucide, Size=16, Color={StaticResource Brand500}}" ContentLayout="Left,8">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding CanManage}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" IsVisible="{Binding CanManage}"
                                ImageSource="{FontImageSource Glyph={x:Static icons:Icons.Pencil}, FontFamily=Lucide, Size=16, Color={StaticResource MutedLight}}" ContentLayout="Left,8" />
                    </Grid>

                    <!-- Historique -->
                    <Label Text="Interventions" Style="{StaticResource TextOverline}" Margin="2,8,0,0" />
                    <Label Text="Aucune intervention pour ce véhicule" Style="{StaticResource TextMeta}"
                           IsVisible="{Binding HasInterventions, Converter={StaticResource InvertedBool}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Interventions}"
                                         BindableLayout.ItemTemplate="{StaticResource InterventionCard}" />

                    <Button Text="Supprimer le véhicule" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanManage}"
                            Margin="0,8,0,0" ImageSource="{FontImageSource Glyph={x:Static icons:Icons.Trash}, FontFamily=Lucide, Size=16, Color={StaticResource RedDot}}" ContentLayout="Left,8" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</views:PageBase>
